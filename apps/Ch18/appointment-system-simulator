<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Appointment System Simulator</title>
  <style>
    :root {
      --bg: #f4f7fb;
      --card: #ffffff;
      --ink: #1d2533;
      --muted: #5f6b82;
      --line: #d9e1ef;
      --accent: #115e59;
      --accent-2: #f08a4b;
      --good: #1d7d46;
      --bad: #b42318;
      --warn: #9a5a00;
      --shadow: 0 10px 28px rgba(16, 28, 52, 0.08);
      --radius: 14px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Avenir Next", "Segoe UI", Tahoma, sans-serif;
      color: var(--ink);
      background:
        radial-gradient(1000px 500px at 95% -5%, #d2f4e6 0%, transparent 56%),
        radial-gradient(900px 450px at -10% 105%, #ffe9d6 0%, transparent 58%),
        var(--bg);
    }

    .wrap {
      max-width: 1180px;
      margin: 24px auto;
      padding: 0 14px 24px;
    }

    .hero {
      background: linear-gradient(130deg, #16324f 0%, #1b6a67 55%, #2a9d8f 100%);
      color: #fff;
      border-radius: var(--radius);
      padding: 18px 20px;
      box-shadow: var(--shadow);
      margin-bottom: 14px;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(1.3rem, 2.4vw, 2rem);
      letter-spacing: 0.2px;
    }

    .hero p {
      margin: 8px 0 0;
      line-height: 1.45;
      font-size: 0.96rem;
      opacity: 0.96;
    }

    .grid {
      display: grid;
      gap: 12px;
    }

    @media (min-width: 980px) {
      .grid.two {
        grid-template-columns: 1fr 1fr;
      }
    }

    .panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 14px;
      margin-bottom: 12px;
    }

    h2 {
      margin: 0 0 8px;
      font-size: 1.08rem;
    }

    .small {
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.4;
    }

    .controls {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      margin-top: 8px;
    }

    label {
      font-size: 0.9rem;
      font-weight: 600;
      color: #2a3650;
      display: block;
      margin-bottom: 5px;
    }

    select,
    input[type="number"] {
      width: 100%;
      border: 1px solid #b9c5dc;
      border-radius: 8px;
      padding: 8px 9px;
      font-size: 0.92rem;
      background: #fff;
      color: var(--ink);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
    }

    th,
    td {
      border-bottom: 1px solid var(--line);
      padding: 7px 8px;
      text-align: left;
      font-size: 0.88rem;
    }

    tr:last-child td {
      border-bottom: none;
    }

    th {
      background: #f4f7ff;
      font-size: 0.86rem;
      letter-spacing: 0.1px;
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 10px;
    }

    .btn {
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.12s ease, filter 0.12s ease;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn:hover {
      filter: brightness(1.04);
    }

    .btn-primary {
      background: var(--accent);
      color: #fff;
    }

    .btn-secondary {
      background: #224870;
      color: #fff;
    }

    .btn-ghost {
      background: #eaf0fd;
      color: #1a3556;
    }

    .status {
      margin-top: 8px;
      padding: 9px 10px;
      border-radius: 10px;
      border-left: 4px solid var(--accent-2);
      background: #fff8ef;
      font-size: 0.9rem;
      line-height: 1.4;
    }

    .feedback {
      margin: 8px 0 0;
      padding-left: 18px;
      font-size: 0.9rem;
      line-height: 1.4;
    }

    .feedback li {
      margin-bottom: 5px;
    }

    .good {
      color: var(--good);
    }

    .bad {
      color: var(--bad);
    }

    .warn {
      color: var(--warn);
    }

    .metric-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 8px;
      margin-top: 8px;
    }

    .metric {
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 8px 9px;
      background: #f8fbff;
    }

    .metric .k {
      display: block;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .metric .v {
      display: block;
      font-weight: 700;
      margin-top: 3px;
      font-size: 1rem;
    }

    .dev {
      margin-top: 8px;
      border: 1px dashed #7294cf;
      border-radius: 10px;
      padding: 10px;
      background: #f1f6ff;
      font-size: 0.88rem;
      line-height: 1.45;
    }

    .task-grid {
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      margin-top: 6px;
    }

    .muted-note {
      margin-top: 8px;
      color: var(--muted);
      font-size: 0.86rem;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <section class="hero">
      <h1>Appointment System Simulator</h1>
      <p>
        Explore tradeoffs among appointment spacing, no-shows, and overbooking in a
        six-customer single-server system.
      </p>
    </section>

    <section class="panel">
      <h2>1) Configure the Appointment System</h2>
      <p class="small">Choose settings, predict idle/waiting behavior, then run a simulation.</p>

      <div class="controls">
        <div>
          <label for="spacing">Appointment spacing (minutes)</label>
          <select id="spacing">
            <option value="30">30</option>
            <option value="45" selected>45</option>
            <option value="60">60</option>
          </select>
        </div>

        <div>
          <label for="setting">Service setting</label>
          <select id="setting">
            <option value="tutoring center">Tutoring center</option>
            <option value="advising office">Advising office</option>
            <option value="clinic">Clinic</option>
            <option value="repair shop">Repair shop</option>
          </select>
        </div>

        <div>
          <label for="noShow">No-show probability</label>
          <select id="noShow">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
          </select>
        </div>

        <div>
          <label for="overbook">Optional overbooking</label>
          <select id="overbook">
            <option value="no" selected>No</option>
            <option value="yes">Yes</option>
          </select>
        </div>
      </div>

      <div class="task-grid">
        <div>
          <label for="prediction">Predict system outcome</label>
          <select id="prediction">
            <option value="">Select...</option>
            <option value="idle">Idle time only</option>
            <option value="wait">Waiting only</option>
            <option value="both">Both idle time and waiting</option>
            <option value="neither">Neither</option>
          </select>
        </div>
      </div>

      <div class="btn-row">
        <button id="runBtn" class="btn btn-primary" type="button">Run Simulation</button>
        <button id="newBtn" class="btn btn-secondary" type="button">New Simulation</button>
        <button id="resetBtn" class="btn btn-ghost" type="button">Reset Student Inputs</button>
      </div>

      <div id="status" class="status">Run a simulation to generate customer outcomes and performance metrics.</div>
    </section>

    <div class="grid two">
      <section class="panel">
        <h2>2) Simulation Timeline (6 Customers)</h2>
        <table aria-label="Simulation table">
          <thead>
            <tr>
              <th>Cust</th>
              <th>Appt</th>
              <th>Show?</th>
              <th>Service</th>
              <th>Start</th>
              <th>End</th>
              <th>Wait</th>
              <th>Idle Before</th>
            </tr>
          </thead>
          <tbody id="simBody"></tbody>
        </table>
        <p class="muted-note">Times are in minutes from opening time.</p>
      </section>

      <section class="panel">
        <h2>3) Student Calculations</h2>
        <p class="small">After running the simulation, calculate these values before checking.</p>

        <div class="task-grid">
          <div>
            <label for="ansMakespan">Makespan</label>
            <input id="ansMakespan" type="number" step="0.01">
          </div>
          <div>
            <label for="ansCapacity">Capacity (customers/min)</label>
            <input id="ansCapacity" type="number" step="0.0001">
          </div>
          <div>
            <label for="ansFlowRate">Flow rate (customers/min)</label>
            <input id="ansFlowRate" type="number" step="0.0001">
          </div>
          <div>
            <label for="ansUtil">Utilization (0 to 1)</label>
            <input id="ansUtil" type="number" step="0.0001" min="0" max="1">
          </div>
        </div>

        <div class="task-grid">
          <div>
            <label for="spacingEval">Spacing appears...</label>
            <select id="spacingEval">
              <option value="">Select...</option>
              <option value="tight">Too tight</option>
              <option value="loose">Too loose</option>
              <option value="reasonable">Reasonable</option>
            </select>
          </div>
          <div>
            <label for="overbookEval">Overbooking impact</label>
            <select id="overbookEval">
              <option value="">Select...</option>
              <option value="improved">Improved system performance</option>
              <option value="worsened">Worsened system performance</option>
            </select>
          </div>
        </div>

        <div class="btn-row">
          <button id="checkBtn" class="btn btn-primary" type="button">Check Answers</button>
        </div>

        <ul id="feedback" class="feedback" aria-live="polite"></ul>
      </section>
    </div>

    <section class="panel">
      <h2>4) Correct Summary Metrics (After You Check)</h2>
      <div id="metricCards" class="metric-cards"></div>
      <p class="muted-note">
        Definitions: makespan = completion of last completed customer - first appointment time;
        capacity = 1 / average service time; flow rate = completed / makespan;
        utilization = busy time / makespan.
      </p>

      <div id="devPanel" class="dev" hidden>
        <strong>Debug / Instructor mode (?dev=1)</strong>
        <div id="devContent"></div>
      </div>
    </section>
  </div>

  <script>
    (function () {
      "use strict";

      var CUSTOMER_COUNT = 6;
      var PROB_MAP = {
        low: 0.12,
        medium: 0.25,
        high: 0.4
      };

      var TOL = 0.02;
      var simResult = null;
      var devMode = new URLSearchParams(window.location.search).get("dev") === "1";

      var simBody = document.getElementById("simBody");
      var statusEl = document.getElementById("status");
      var metricCards = document.getElementById("metricCards");
      var feedbackEl = document.getElementById("feedback");
      var devPanel = document.getElementById("devPanel");
      var devContent = document.getElementById("devContent");

      function rand(min, max) {
        return min + Math.random() * (max - min);
      }

      function round2(n) {
        return Math.round(n * 100) / 100;
      }

      function safeFixed(n, digits) {
        if (!Number.isFinite(n)) {
          return "0";
        }
        return n.toFixed(digits);
      }

      function selected(id) {
        return document.getElementById(id).value;
      }

      function numericValue(id) {
        var raw = document.getElementById(id).value.trim();
        if (raw === "") {
          return null;
        }
        var n = Number(raw);
        return Number.isFinite(n) ? n : null;
      }

      function resetStudentInputs() {
        [
          "ansMakespan",
          "ansCapacity",
          "ansFlowRate",
          "ansUtil"
        ].forEach(function (id) {
          document.getElementById(id).value = "";
        });

        ["prediction", "spacingEval", "overbookEval"].forEach(function (id) {
          document.getElementById(id).value = "";
        });

        feedbackEl.innerHTML = "";
      }

      function makeAppointments(spacing, overbook) {
        var appointments = [];
        if (overbook === "yes") {
          appointments = [0, 0, spacing, spacing * 2, spacing * 3, spacing * 4];
        } else {
          for (var i = 0; i < CUSTOMER_COUNT; i += 1) {
            appointments.push(i * spacing);
          }
        }
        return appointments;
      }

      function generateCustomerProfiles(spacing, noShowProb) {
        var profiles = [];
        var serviceLow = Math.max(10, spacing * 0.65);
        var serviceHigh = spacing * 1.35;

        for (var i = 0; i < CUSTOMER_COUNT; i += 1) {
          profiles.push({
            id: i + 1,
            serviceTime: round2(rand(serviceLow, serviceHigh)),
            showsUp: Math.random() >= noShowProb
          });
        }
        return profiles;
      }

      function runSingleSimulation(appointments, profiles) {
        var rows = [];
        var currentTime = 0;
        var busyTime = 0;
        var totalWait = 0;
        var maxWait = 0;
        var waitedCount = 0;
        var idleTime = 0;
        var totalService = 0;
        var completed = 0;

        for (var i = 0; i < CUSTOMER_COUNT; i += 1) {
          var appt = appointments[i];
          var p = profiles[i];

          if (!p.showsUp) {
            rows.push({
              customer: p.id,
              appointment: appt,
              show: "No",
              service: 0,
              start: "-",
              end: "-",
              wait: 0,
              idleBefore: 0
            });
            continue;
          }

          var idleBefore = 0;
          if (appt > currentTime) {
            idleBefore = appt - currentTime;
            idleTime += idleBefore;
          }

          var start = Math.max(appt, currentTime);
          var wait = Math.max(0, start - appt);
          var end = start + p.serviceTime;

          busyTime += p.serviceTime;
          totalService += p.serviceTime;
          totalWait += wait;
          completed += 1;

          if (wait > 0) {
            waitedCount += 1;
          }
          if (wait > maxWait) {
            maxWait = wait;
          }

          currentTime = end;

          rows.push({
            customer: p.id,
            appointment: appt,
            show: "Yes",
            service: p.serviceTime,
            start: round2(start),
            end: round2(end),
            wait: round2(wait),
            idleBefore: round2(idleBefore)
          });
        }

        var firstStart = appointments[0];
        var makespan = completed > 0 ? Math.max(0, currentTime - firstStart) : 0;
        var avgService = completed > 0 ? totalService / completed : 0;
        var capacity = avgService > 0 ? 1 / avgService : 0;
        var flowRate = makespan > 0 ? completed / makespan : 0;
        var utilization = makespan > 0 ? busyTime / makespan : 0;
        var avgWait = completed > 0 ? totalWait / completed : 0;

        return {
          rows: rows,
          metrics: {
            makespan: round2(makespan),
            averageServiceTime: round2(avgService),
            capacity: capacity,
            flowRate: flowRate,
            utilization: utilization,
            averageWaitTime: round2(avgWait),
            maximumWaitTime: round2(maxWait),
            waitedCount: waitedCount,
            completedCustomers: completed,
            busyTime: round2(busyTime),
            idleTime: round2(idleTime)
          }
        };
      }

      function classifyPrediction(metrics) {
        var hasIdle = metrics.idleTime > 0;
        var hasWait = metrics.waitedCount > 0;

        if (hasIdle && hasWait) {
          return "both";
        }
        if (hasIdle) {
          return "idle";
        }
        if (hasWait) {
          return "wait";
        }
        return "neither";
      }

      function spacingAssessment(metrics, spacing) {
        if (metrics.averageWaitTime > spacing * 0.25) {
          return "tight";
        }
        if (metrics.idleTime > metrics.makespan * 0.25) {
          return "loose";
        }
        return "reasonable";
      }

      function overbookingAssessment(chosenMetrics, altMetrics) {
        var chosenScore = chosenMetrics.idleTime + (1.5 * chosenMetrics.averageWaitTime);
        var altScore = altMetrics.idleTime + (1.5 * altMetrics.averageWaitTime);
        return chosenScore <= altScore ? "improved" : "worsened";
      }

      function renderTable(rows) {
        var html = rows.map(function (r) {
          return "<tr>" +
            "<td>C" + r.customer + "</td>" +
            "<td>" + r.appointment + "</td>" +
            "<td>" + r.show + "</td>" +
            "<td>" + (r.show === "Yes" ? r.service : "-") + "</td>" +
            "<td>" + r.start + "</td>" +
            "<td>" + r.end + "</td>" +
            "<td>" + r.wait + "</td>" +
            "<td>" + r.idleBefore + "</td>" +
            "</tr>";
        }).join("");

        simBody.innerHTML = html;
      }

      function renderMetrics(metrics) {
        var cards = [
          ["Makespan", safeFixed(metrics.makespan, 2) + " min"],
          ["Average service time", safeFixed(metrics.averageServiceTime, 2) + " min"],
          ["Capacity", safeFixed(metrics.capacity, 4) + " cust/min"],
          ["Flow rate", safeFixed(metrics.flowRate, 4) + " cust/min"],
          ["Utilization", safeFixed(metrics.utilization, 4)],
          ["Average wait", safeFixed(metrics.averageWaitTime, 2) + " min"],
          ["Maximum wait", safeFixed(metrics.maximumWaitTime, 2) + " min"],
          ["Customers waited", String(metrics.waitedCount)]
        ];

        metricCards.innerHTML = cards.map(function (c) {
          return "<div class='metric'><span class='k'>" + c[0] + "</span><span class='v'>" + c[1] + "</span></div>";
        }).join("");
      }

      function renderDev(result) {
        if (!devMode) {
          devPanel.hidden = true;
          return;
        }

        devPanel.hidden = false;
        var m = result.metrics;
        var lines = [
          "Correct makespan: " + safeFixed(m.makespan, 2),
          "Correct capacity (cust/min): " + safeFixed(m.capacity, 4),
          "Correct flow rate (cust/min): " + safeFixed(m.flowRate, 4),
          "Correct utilization: " + safeFixed(m.utilization, 4),
          "Correct prediction label: " + result.correctPrediction,
          "Correct spacing assessment: " + result.correctSpacing,
          "Correct overbooking assessment: " + result.correctOverbook
        ];

        devContent.innerHTML = lines.join("<br>");
      }

      function runSimulation() {
        var spacing = Number(selected("spacing"));
        var overbook = selected("overbook");
        var setting = selected("setting");
        var noShowLevel = selected("noShow");
        var noShowProb = PROB_MAP[noShowLevel];

        var profiles = generateCustomerProfiles(spacing, noShowProb);
        var chosenAppointments = makeAppointments(spacing, overbook);
        var altAppointments = makeAppointments(spacing, overbook === "yes" ? "no" : "yes");

        var chosen = runSingleSimulation(chosenAppointments, profiles);
        var alt = runSingleSimulation(altAppointments, profiles);

        var predictionClass = classifyPrediction(chosen.metrics);
        var spacingClass = spacingAssessment(chosen.metrics, spacing);
        var overbookClass = overbookingAssessment(chosen.metrics, alt.metrics);

        simResult = {
          input: {
            spacing: spacing,
            setting: setting,
            noShowLevel: noShowLevel,
            overbook: overbook
          },
          rows: chosen.rows,
          metrics: chosen.metrics,
          altMetrics: alt.metrics,
          correctPrediction: predictionClass,
          correctSpacing: spacingClass,
          correctOverbook: overbookClass
        };

        renderTable(simResult.rows);
        renderMetrics(simResult.metrics);
        renderDev(simResult);

        statusEl.textContent = "Simulation complete for " + setting + ". Completed customers: " +
          simResult.metrics.completedCustomers + "/" + CUSTOMER_COUNT +
          ". Now check your calculations and decisions.";

        feedbackEl.innerHTML = "";
      }

      function checkNumeric(student, truth, label, digits, feedback) {
        if (student === null) {
          feedback.push({ type: "bad", msg: label + " is blank." });
          return;
        }

        var diff = Math.abs(student - truth);
        if (diff <= TOL) {
          feedback.push({ type: "good", msg: label + " is correct." });
        } else {
          feedback.push({ type: "bad", msg: label + " should be " + truth.toFixed(digits) + "." });
        }
      }

      function checkAnswers() {
        var feedback = [];

        if (!simResult) {
          feedbackEl.innerHTML = "<li class='bad'>Run the simulation before checking answers.</li>";
          return;
        }

        var m = simResult.metrics;

        checkNumeric(numericValue("ansMakespan"), m.makespan, "Makespan", 2, feedback);
        checkNumeric(numericValue("ansCapacity"), m.capacity, "Capacity", 4, feedback);
        checkNumeric(numericValue("ansFlowRate"), m.flowRate, "Flow rate", 4, feedback);
        checkNumeric(numericValue("ansUtil"), m.utilization, "Utilization", 4, feedback);

        var pred = selected("prediction");
        if (!pred) {
          feedback.push({ type: "bad", msg: "Prediction (idle/wait/both/neither) is blank." });
        } else if (pred === simResult.correctPrediction) {
          feedback.push({ type: "good", msg: "Prediction about idle/wait is correct." });
        } else {
          feedback.push({ type: "bad", msg: "Prediction should be: " + simResult.correctPrediction + "." });
        }

        var spacingEval = selected("spacingEval");
        if (!spacingEval) {
          feedback.push({ type: "bad", msg: "Spacing evaluation is blank." });
        } else if (spacingEval === simResult.correctSpacing) {
          feedback.push({ type: "good", msg: "Spacing assessment is correct." });
        } else {
          feedback.push({ type: "bad", msg: "Spacing assessment should be: " + simResult.correctSpacing + "." });
        }

        var overbookEval = selected("overbookEval");
        if (!overbookEval) {
          feedback.push({ type: "bad", msg: "Overbooking assessment is blank." });
        } else if (overbookEval === simResult.correctOverbook) {
          feedback.push({ type: "good", msg: "Overbooking assessment is correct." });
        } else {
          feedback.push({ type: "bad", msg: "Overbooking assessment should be: " + simResult.correctOverbook + "." });
        }

        feedbackEl.innerHTML = feedback.map(function (f) {
          return "<li class='" + f.type + "'>" + f.msg + "</li>";
        }).join("");
      }

      function newSimulation() {
        resetStudentInputs();
        simBody.innerHTML = "";
        metricCards.innerHTML = "";
        simResult = null;
        statusEl.textContent = "Run a simulation to generate customer outcomes and performance metrics.";
        renderDev({ metrics: {}, correctPrediction: "-", correctSpacing: "-", correctOverbook: "-" });
      }

      document.getElementById("runBtn").addEventListener("click", runSimulation);
      document.getElementById("checkBtn").addEventListener("click", checkAnswers);
      document.getElementById("newBtn").addEventListener("click", newSimulation);
      document.getElementById("resetBtn").addEventListener("click", resetStudentInputs);

      newSimulation();
    })();
  </script>
</body>
</html>
